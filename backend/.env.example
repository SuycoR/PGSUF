# Copy this file to .env (git-ignored) and fill in the values. Never commit real secrets.
DB_URL=jdbc:mysql://127.0.0.1:3306/servicios_universitarios?serverTimezone=America/Lima
DB_USER=
DB_PASSWORD=
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
# Comma-separated list of allowed origins (required in prod; never '*' with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
UPLOAD_DIR=./uploads
ADMIN_EMAIL=
ADMIN_PASSWORD=
SPRING_PROFILES_ACTIVE=dev
