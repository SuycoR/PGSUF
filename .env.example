# ==============================================================================
# PGSUF - Archivo de variables de entorno de ejemplo (.env.example)
# Copiar este archivo a .env y completar los valores secretos antes de desplegar.
# ==============================================================================

# Entorno: dev, test, prod
SPRING_PROFILES_ACTIVE=dev

# Base de datos MySQL
DB_URL=jdbc:mysql://127.0.0.1:3306/servicios_universitarios?serverTimezone=America/Lima
DB_USER=app_servicios
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Autenticación JWT (Generar con: openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# Seguridad CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
CORS_ALLOW_CREDENTIALS=false

# Rate Limiting de Login (Protección contra fuerza bruta)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Almacenamiento de archivos de evidencias
UPLOAD_DIR=./uploads

# Administrador inicial del sistema (creado en el primer inicio si no existe)
ADMIN_EMAIL=admin@unmsm.edu.pe
ADMIN_PASSWORD=
