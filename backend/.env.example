DB_USER=
DB_PASSWORD=
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
ADMIN_EMAIL=
ADMIN_PASSWORD=
SPRING_PROFILES_ACTIVE=dev
